rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profiles
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // Public Items (Lost & Found reports)
    match /items/{itemId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;

      // Private verification details subcollection - for verification
      match /private/{documentId} {
        allow read, write: if true;
      }
    }

    // AI Potential Matches
    match /matches/{matchId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Verification claims
    match /claims/{claimId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // User notifications
    match /notifications/{notificationId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Suspicious listing flags
    match /flags/{flagId} {
      allow read, create, update: if true;
    }

    // Test connection doc
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
